cat > .gitignore <<'EOF'
# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# next.js
.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env files
.env*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.py[cod]
.venv/
backend/.venv/

# os / ide
.DS_Store
*.pem
.idea/
.vscode/

# vercel
.vercel

# one-off helper scripts
/fix_calcs.py
/gold_theme.py
/resolve_merge.sh
/merged_main.py
/merged_config.py
EOF